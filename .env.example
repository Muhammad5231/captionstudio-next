# CaptionStudio Environment Configuration
APP_NAME=CaptionStudio
APP_ENV=development
DEBUG=true

# API Server
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database & Storage
DATABASE_URL=sqlite:///./data/database/captionstudio.db
STORAGE_ROOT=./storage

# Local Media Tools (Auto-detected if in project root or system PATH)
FFMPEG_PATH=./ffmpeg.exe
FFPROBE_PATH=./ffprobe.exe

# Local AI / Faster-Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=./data/models

# Limits & Validation
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=60

